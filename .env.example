# Safe template only. Never place real credentials in this file.
# A real .env is not needed for public market discovery.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5173
LOG_LEVEL=INFO

# Initial allowlist: original bot markets. Edit this comma-separated list later.
MARKET_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
MARKET_QUOTE_ASSET=USDT
# Optional exclusion list; symbols here will never be marked eligible.
MARKET_EXCLUDED_SYMBOLS=

# Allowed modes: BACKTEST, PAPER, BINANCE_SPOT_TESTNET, BINANCE_SPOT_LIVE
DEFAULT_TRADING_MODE=BACKTEST
LIVE_TRADING_ENABLED=false

# Separate placeholders for future authenticated features. Keep blank for now.
BINANCE_SPOT_TESTNET_API_KEY=
BINANCE_SPOT_TESTNET_API_SECRET=
BINANCE_SPOT_LIVE_API_KEY=
BINANCE_SPOT_LIVE_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Configurable Binance candle intervals (case-sensitive; all nine approved intervals enabled by default).
SUPPORTED_CANDLE_INTERVALS=1m,3m,5m,15m,30m,1h,2h,4h,1d

# Starter timeframe mappings for research/data alignment only; not validated trading strategies.
SCALP_ENTRY_INTERVAL=1m
SCALP_CONTEXT_INTERVALS=3m,5m
DAY_ENTRY_INTERVAL=5m
DAY_CONTEXT_INTERVALS=15m,1h
SWING_ENTRY_INTERVAL=1h
SWING_CONTEXT_INTERVALS=4h,1d
